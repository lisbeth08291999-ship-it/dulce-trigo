PORT=3000

# Contraseña del panel de administrador
ADMIN_PASSWORD=cambia-esta-clave

# Conexión a PostgreSQL (en Railway: copia DATABASE_URL del servicio Postgres)
DATABASE_URL=postgresql://usuario:clave@host:5432/nombre_bd

# Pon true si tu proveedor exige SSL (conexiones externas a Railway/Render)
DATABASE_SSL=false
